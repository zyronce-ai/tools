# === SUPABASE (naya project create karke ye values daalo) ===
# 1. https://supabase.com → New Project
# 2. Project Settings → API me jaake ye copy karo
VITE_SUPABASE_PROJECT_ID="<tumhara-project-id>"
VITE_SUPABASE_PUBLISHABLE_KEY="<tumhara-anon-key>"
VITE_SUPABASE_URL="https://<tumhara-project-id>.supabase.co"

# === AI PROVIDERS ===
# Groq — text-only requests, fast + higher free-tier limit
# https://console.groq.com/keys
GROQ_API_KEY="<tumhari-groq-api-key>"

# Gemini — vision requests, image gen, aur Groq fallback
# https://aistudio.google.com/apikey
GEMINI_API_KEY="<tumhari-gemini-api-key>"
